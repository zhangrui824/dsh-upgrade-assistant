{
  "name": "dsh-upgrade-assistant",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Centralized upgrade assistant for DSH plugins",
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
